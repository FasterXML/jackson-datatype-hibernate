<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<persistence version="1.0" 
	xmlns="http://java.sun.com/xml/ns/persistence" 
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_1_0.xsd">

    <persistence-unit name="persistenceUnit" transaction-type="RESOURCE_LOCAL">
      <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
      <class>tools.jackson.datatype.hibernate7.data.Customer</class>
      <class>tools.jackson.datatype.hibernate7.data.Employee</class>
      <class>tools.jackson.datatype.hibernate7.data.Office</class>
      <class>tools.jackson.datatype.hibernate7.data.Order</class>
      <class>tools.jackson.datatype.hibernate7.data.OrderDetail</class>
      <class>tools.jackson.datatype.hibernate7.data.OrderDetailId</class>
      <class>tools.jackson.datatype.hibernate7.data.Payment</class>
      <class>tools.jackson.datatype.hibernate7.data.PaymentId</class>
      <class>tools.jackson.datatype.hibernate7.data.Product</class>
      <properties>
        <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
        <property name="jakarta.persistence.jdbc.user" value=""/>
        <property name="jakarta.persistence.jdbc.password" value=""/>
        <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:;DB_CLOSE_DELAY=-1;INIT=RUNSCRIPT FROM 'classpath:/classicmodels.sql'"/>
        <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      </properties>
    </persistence-unit>
    
</persistence>
